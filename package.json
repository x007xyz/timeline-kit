{
  "name": "timeline-kit",
  "version": "0.2.0",
  "type": "module",
  "description": "Framework-agnostic, plugin-driven DOM+Canvas timeline editor with lightweight TimelineDocument model, bidirectional OTIO adapter, and React/Vue adapters",
  "keywords": [
    "timeline",
    "video-editor",
    "audio",
    "editor",
    "nle",
    "otio",
    "opentimelineio",
    "canvas",
    "react",
    "vue"
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/types/src/core-entry.d.ts",
      "import": "./dist/core.js"
    },
    "./otio": {
      "types": "./dist/types/src/otio-entry.d.ts",
      "import": "./dist/otio.js"
    },
    "./plugins": {
      "types": "./dist/types/src/plugins-entry.d.ts",
      "import": "./dist/plugins.js"
    },
    "./react": {
      "types": "./dist/types/adapters/react/index.d.ts",
      "import": "./dist/react.js"
    },
    "./vue": {
      "types": "./dist/types/adapters/vue/index.d.ts",
      "import": "./dist/vue.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:adapters": "tsc --noEmit -p tsconfig.adapters.json",
    "test": "node --import ./scripts/ts-resolve-hook.mjs --test tests/*.test.ts",
    "test:e2e": "node --test tests/e2e/*.e2e.test.mjs",
    "test:all": "npm run lint && npm run typecheck && npm run typecheck:adapters && npm run test && npm run test:e2e",
    "serve": "node ./scripts/dev-server.mjs",
    "docs:gen-api": "node ./scripts/gen-api-docs.mjs",
    "docs:verify": "node ./scripts/verify-docs.mjs",
    "dev": "vite",
    "build": "npm run clean && vite build && tsc -p tsconfig.build.json && node scripts/fix-dts-extensions.mjs",
    "build:demo": "vite build --mode demo",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "eslint .",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run typecheck:adapters && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@happy-dom/global-registrator": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "mediabunny": "^1.66.2",
    "react": "^19",
    "react-dom": "^19",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8",
    "vite": "^5.4.0",
    "vue": "^3.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
